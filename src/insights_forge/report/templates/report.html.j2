<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="insights-forge {{ version }}">
<title>{{ name }} · Data report</title>
<style>
  :root {
    color-scheme: light;
    --page: #f9f9f7; --surface: #fcfcfb; --ink: #0b0b0b; --ink-2: #52514e; --muted: #898781;
    --line: #e1e0d9; --accent: #2a78d6; --bar-track: #ecebe6;
    --critical: #d03b3b; --warning: #b87d00; --info: #2a78d6;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      color-scheme: dark;
      --page: #0d0d0d; --surface: #1a1a19; --ink: #f0efec; --ink-2: #c3c2b7; --muted: #898781;
      --line: #2c2c2a; --accent: #3987e5; --bar-track: #2c2c2a;
      --critical: #e66767; --warning: #fab219; --info: #3987e5;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--page); color: var(--ink);
    font: 15px/1.55 system-ui, -apple-system, "Segoe UI", sans-serif;
  }
  main { max-width: 1080px; margin: 0 auto; padding: 32px 16px 64px; }
  header { margin-bottom: 28px; }
  h1 { font-size: 28px; line-height: 1.2; margin: 0 0 6px; }
  h2 { font-size: 19px; margin: 40px 0 12px; }
  .meta { color: var(--ink-2); font-size: 14px; }
  .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; }
  .kpi, .card {
    background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px;
  }
  .kpi .label { color: var(--ink-2); font-size: 13px; }
  .kpi .value { font-size: 26px; font-weight: 600; margin-top: 2px; }
  ol.insights { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  ol.insights li { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 12px 16px; }
  .kind { display: inline-block; font-size: 12px; color: var(--ink-2); border: 1px solid var(--line);
          border-radius: 999px; padding: 0 8px; margin-bottom: 4px; }
  .insight-title { font-weight: 600; }
  .insight-detail { color: var(--ink-2); }
  .table-wrap { overflow-x: auto; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  th, td { text-align: left; padding: 8px 12px; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { color: var(--ink-2); font-weight: 600; white-space: nowrap; }
  tr:last-child td { border-bottom: 0; }
  td.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .sev { white-space: nowrap; font-weight: 600; }
  .sev-critical { color: var(--critical); } .sev-warning { color: var(--warning); } .sev-info { color: var(--info); }
  .bar { display: flex; align-items: center; gap: 8px; min-width: 120px; }
  .bar span { flex: 1; height: 6px; border-radius: 3px; background: var(--bar-track); overflow: hidden; }
  .bar i { display: block; height: 100%; background: var(--accent); border-radius: 3px; }
  .note { color: var(--muted); font-size: 13px; margin-top: 8px; }
  .chart { padding: 8px; }
  footer { margin-top: 48px; color: var(--muted); font-size: 13px; }
  a { color: var(--accent); }
  code { font-size: 13px; }
</style>
</head>
<body>
<main>
  <header>
    <h1>{{ name }}</h1>
    <div class="meta">
      Data report · generated {{ generated_at }} · {{ profile.rows | thousands }} rows × {{ profile.n_columns }} columns
      · analyzing <strong>{{ insights.roles.measure_label }}</strong>{% if insights.roles.date %} over <code>{{ insights.roles.date }}</code>{% endif %}
    </div>
  </header>

  <section class="kpis" aria-label="Summary">
    <div class="kpi"><div class="label">Rows</div><div class="value">{{ profile.rows | thousands }}</div></div>
    <div class="kpi"><div class="label">Columns</div><div class="value">{{ profile.n_columns }}</div></div>
    <div class="kpi"><div class="label">Complete cells</div><div class="value">{{ "%.1f" | format(profile.completeness_pct) }}%</div></div>
    <div class="kpi"><div class="label">Duplicate rows</div><div class="value">{{ profile.duplicate_rows | thousands }}</div></div>
    <div class="kpi"><div class="label">Quality issues</div><div class="value">{{ profile.issues | length }}</div></div>
  </section>

  <h2>Key insights</h2>
  {% if insights.insights %}
  <ol class="insights">
    {% for i in insights.insights %}
    <li>
      <span class="kind">{{ i.kind }}</span>
      <div class="insight-title">{{ i.title }}</div>
      <div class="insight-detail">{{ i.detail }}</div>
    </li>
    {% endfor %}
  </ol>
  {% else %}
  <p class="meta">No notable patterns were found with the current settings.</p>
  {% endif %}

  {% if trend_chart %}
  <h2>{{ insights.roles.measure_label | capitalize }} by {{ insights.trend.granularity }}</h2>
  <div class="card chart">{{ trend_chart }}</div>
  <p class="note">Dotted line: least-squares linear trend.</p>
  {% endif %}

  <h2>Data quality</h2>
  {% if profile.issues %}
  <div class="table-wrap"><table>
    <thead><tr><th>Severity</th><th>Column</th><th>Issue</th><th class="num">Rows</th></tr></thead>
    <tbody>
    {% for issue in profile.issues %}
      <tr>
        <td class="sev sev-{{ issue.severity }}">{{ severity_icon[issue.severity] }} {{ issue.severity | capitalize }}</td>
        <td>{{ issue.column or "(whole table)" }}</td>
        <td>{{ issue.message }}</td>
        <td class="num">{{ issue.affected_rows | thousands if issue.affected_rows else "" }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table></div>
  {% else %}
  <p class="meta">✅ No data-quality issues found.</p>
  {% endif %}

  <h2>Columns</h2>
  <div class="table-wrap"><table>
    <thead><tr><th>Column</th><th>Type</th><th>Filled</th><th class="num">Distinct</th><th>Summary</th></tr></thead>
    <tbody>
    {% for c in profile.columns %}
      <tr>
        <td><code>{{ c.name }}</code></td>
        <td>{{ c.dtype }}</td>
        <td><div class="bar"><span><i style="width: {{ "%.1f" | format(100 - c.null_pct) }}%"></i></span>{{ "%.1f" | format(100 - c.null_pct) }}%</div></td>
        <td class="num">{{ c.distinct | thousands }}</td>
        <td>{{ column_summary(c) }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table></div>

  {% if correlation_chart %}
  <h2>Correlations</h2>
  <div class="card chart">{{ correlation_chart }}</div>
  <p class="note">Pearson r between numeric columns: +1 move together, −1 move in opposite directions. Correlation is not causation.</p>
  {% endif %}

  <footer>
    Generated by <a href="https://github.com/JuanAvendan/insights-forge">insights-forge</a> v{{ version }}.
    Insights are rule-based heuristics: review them before making decisions.
  </footer>
</main>
</body>
</html>
